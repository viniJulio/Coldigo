{
  "name": "coldigo",
  "version": "1.0.0",
  "description": "Ferramenta de análise gráfica para estimar movimentações no day trade",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node --test test/*.test.js",
    "avaliar": "node scripts/avaliar.js",
    "versao": "node scripts/versao.js",
    "ponte": "node ponte/servidor.js",
    "nfse": "node --disable-warning=ExperimentalWarning nfse/server.js",
    "nfse:test": "node --disable-warning=ExperimentalWarning --test nfse/test/*.test.js"
  }
}
